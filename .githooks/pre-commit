#!/bin/sh

# No real CTF answer may ever be committed. The working tree was redacted once
# but the answers were already in history, which is exactly the recurrence this
# blocks. Placeholders (THM{flag for question #N}) pass; anything else does not.
leaked=$(git diff --cached -U0 | grep '^+' | grep -oE 'THM\{[^}]*\}' | grep -v 'flag for question' || true)
if [ -n "$leaked" ]; then
  echo "" >&2
  echo "pre-commit BLOCKED: a real CTF flag is staged:" >&2
  echo "$leaked" | sed 's/^/    /' >&2
  echo "  Use THM{flag for question #N}. TryHackMe AUP." >&2
  echo "" >&2
  exit 1
fi

# Room credentials and answer hashes, same reasoning.
creds=$(git diff --cached -U0 | grep '^+' | grep -ioE "(DB_PASS|JWT_SECRET|APP_SECRET)', *'[^']+'" | grep -vi "redacted" || true)
if [ -n "$creds" ]; then
  echo "" >&2
  echo "pre-commit BLOCKED: room credentials staged unredacted:" >&2
  echo "$creds" | sed 's/^/    /' >&2
  exit 1
fi

# No agent-instruction file may ever be committed to this repo - it is served
# publicly by GitHub Pages. Atharva's rule, 2026-09-19. Catches `git add -f`,
# which .gitignore alone cannot stop.
staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -iE '(^|/)(claude|agents|gemini)\.md$|(^|/)\.cursorrules$' || true)
if [ -n "$staged" ]; then
  echo "" >&2
  echo "pre-commit BLOCKED: agent-instruction file staged for a PUBLIC repo:" >&2
  echo "$staged" | sed 's/^/    /' >&2
  echo "  This repo is served by GitHub Pages. Keep it in _local/ instead." >&2
  echo "" >&2
  exit 1
fi
# Portfolio consistency invariants — see tools/check-consistency.mjs
# Bypass only with a deliberate --no-verify and a good reason.
if command -v node >/dev/null 2>&1; then
  node tools/check-consistency.mjs || {
    echo ""
    echo "pre-commit BLOCKED: surfaces disagree. Fix the drift above, or re-run with --no-verify if you truly mean it."
    exit 1
  }
else
  echo "pre-commit: node not found — skipping consistency check." >&2
fi

# Keep sitemap.xml lastmod honest. A hand-set date silently goes stale, which is
# what happened to 7 of 8 URLs.
if command -v node >/dev/null 2>&1 && [ -f tools/build-sitemap.mjs ]; then
  node tools/build-sitemap.mjs >/dev/null 2>&1 && git add sitemap.xml
fi
